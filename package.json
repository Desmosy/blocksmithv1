{
  "name": "blocksmith",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "workspaces": [
    "packages/*",
    "packages/generated/*"
  ],
  "scripts": {
    "clean": "rm -rf .next node_modules/.cache",
    "dev": "node scripts/dev.mjs",
    "dev:clean": "node scripts/dev.mjs --clean",
    "build": "node scripts/guard-build.mjs && node scripts/ensure-pulse.mjs && next build",
    "build:pulse": "npm run codegen:pulse && npm install --ignore-scripts --include=dev && npm run build -w @blocksmith/pulse-runtime && npm run build -w @blocksmith/acme-ui-kit",
    "postinstall": "node scripts/ensure-pulse.mjs",
    "build:clean": "npm run clean && next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "verify:design-ir": "tsx scripts/verify-design-ir.ts",
    "verify:wiki": "tsx scripts/verify-wiki-parse.ts",
    "verify:modify-tokens": "tsx scripts/verify-modify-tokens.ts",
    "ai-lab:chrome": "tsx scripts/ai-lab/01-test-chrome.ts",
    "ai-lab:normalize": "tsx scripts/ai-lab/02-test-normalize.ts",
    "ai-lab:previews": "tsx scripts/ai-lab/04-test-previews.ts",
    "ai-lab:fonts": "tsx scripts/ai-lab/05-test-font-resolve.ts",
    "pretext-components:test": "tsx scripts/pretext-components/test-gallery.ts",
    "mcp": "npx tsx --conditions=react-server src/mcp/server.ts",
    "mcp:probe": "tsx scripts/mcp-probe-connector.ts",
    "scan": "tsx --conditions=react-server scripts/scan-workspace.ts",
    "scan:vendor": "BLOCKSMITH_WORKSPACE=fixtures/vendor-ui AI_LAB_SCAN_CURATE=0 tsx --conditions=react-server scripts/scan-workspace.ts",
    "verify:goal1": "npm run verify:vendor-fixture && npm run verify:vendor-e2e && tsx --conditions=react-server scripts/verify-external-vendor.ts && tsx --conditions=react-server scripts/verify-scan-backend.ts",
    "verify:goal1:full": "npm run verify:goal1 && npm run verify:github-scan",
    "scan:verify": "tsx --conditions=react-server scripts/verify-scan-coverage.ts",
    "verify:scan-wiki": "tsx --conditions=react-server scripts/verify-scan-wiki.ts",
    "verify:vendor-fixture": "tsx --conditions=react-server scripts/verify-vendor-fixture.ts",
    "verify:vendor-e2e": "tsx --conditions=react-server scripts/verify-vendor-e2e.ts",
    "verify:handshake-writeback": "tsx --conditions=react-server scripts/verify-handshake-writeback.ts",
    "verify:handshake-pull": "tsx --conditions=react-server scripts/verify-handshake-pull.ts",
    "verify:handshake-acceptance": "tsx --conditions=react-server scripts/verify-handshake-acceptance.ts",
    "verify:governance-copilot": "tsx --conditions=react-server scripts/verify-governance-copilot.ts",
    "verify:saas-acl": "tsx --conditions=react-server scripts/verify-saas-acl.ts",
    "verify:security-gate": "tsx --conditions=react-server scripts/verify-security-gate.ts",
    "verify:org-rbac": "tsx --conditions=react-server scripts/verify-org-rbac.ts",
    "verify:governance-e2e": "tsx --conditions=react-server scripts/verify-governance-e2e.ts",
    "verify:governance-tiers": "tsx --conditions=react-server scripts/verify-governance-tiers.ts",
    "verify:mcp-sync": "tsx --conditions=react-server scripts/verify-mcp-sync-status.ts",
    "verify:production-smoke": "tsx scripts/verify-production-smoke.ts",
    "verify:production-goals": "tsx scripts/verify-production-goals.ts",
    "verify:sync-conflict": "tsx --conditions=react-server scripts/verify-sync-conflict.ts",
    "verify:software": "npm run typecheck && npm run scan:verify && npm run verify:scan-wiki && npm run verify:wiki && npm run verify:vendor-fixture && npm run verify:vendor-e2e && npm run verify:handshake-writeback && npm run verify:handshake-pull && npm run verify:handshake-acceptance && npm run verify:sync-conflict && npm run verify:saas-acl && npm run verify:security-gate && npm run verify:org-rbac && npm run verify:governance-e2e && npm run verify:governance-tiers && npm run verify:mcp-sync && npm run verify:component-interface && npm run verify:pulse",
    "verify:workable": "npm run verify:software && npm run verify:supabase && npm run verify:cloud-api && tsx scripts/verify-workable.ts",
    "activity:from-commit": "tsx --conditions=react-server scripts/activity-from-commit.ts",
    "governance:check": "tsx --conditions=react-server scripts/governance-gate.ts",
    "validate:ui": "tsx --conditions=react-server scripts/validate-ui.ts",
    "verify:ir-cicd": "tsx --conditions=react-server scripts/verify-ir-cicd.ts",
    "compile:device": "tsx --conditions=react-server scripts/compile-device.ts",
    "protocol:conformance": "tsx packages/protocol/conformance/run.ts && tsx --conditions=react-server packages/protocol/conformance/drift.ts",
    "protocol:sync-schemas": "node scripts/sync-protocol-schemas.mjs",
    "ingest:storybook": "tsx --conditions=react-server scripts/ingest-storybook.ts",
    "build:sdk": "npm run build -w @blocksmith/sdk",
    "build:cli": "npm run build -w @block-smith/cli",
    "build:packages": "npm run build:sdk && npm run build:cli",
    "publish:packages": "node scripts/publish-packages.mjs",
    "publish:packages:dry-run": "node scripts/publish-packages.mjs --dry-run",
    "verify:cloud-api": "tsx --conditions=react-server scripts/verify-cloud-api.ts",
    "verify:supabase": "tsx --conditions=react-server scripts/verify-supabase.ts",
    "verify:patterns-live": "tsx --conditions=react-server scripts/verify-patterns-live.ts",
    "codegen:pulse": "tsx --conditions=react-server scripts/codegen-pulse.ts",
    "verify:pulse": "tsx --conditions=react-server scripts/verify-pulse.ts",
    "verify:component-interface": "tsx scripts/verify-component-interface.ts",
    "verify:github-scan": "tsx --conditions=react-server scripts/verify-github-scan.ts",
    "verify:figma-import": "tsx --conditions=react-server scripts/verify-figma-import.ts",
    "verify:webmcp": "tsx --conditions=react-server scripts/verify-webmcp.ts",
    "demo:reset": "node scripts/demo-reset.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@blocksmith/acme-ui-kit": "file:packages/generated/acme-ui-kit",
    "@blocksmith/pretext-components": "file:packages/pretext-components",
    "@blocksmith/pulse-runtime": "file:packages/pulse-runtime",
    "@chenglou/pretext": "^0.0.7",
    "@figma/rest-api-spec": "^0.41.0",
    "@heroicons/react": "^2.2.0",
    "@hookform/resolvers": "^5.4.0",
    "@icon-pkg/streamline-core-line-free": "^0.3.0",
    "@modelcontextprotocol/sdk": "^1.12.1",
    "@octokit/rest": "^22.0.1",
    "@radix-ui/react-avatar": "^1.2.2",
    "@radix-ui/react-collapsible": "^1.1.16",
    "@radix-ui/react-dropdown-menu": "^2.1.20",
    "@radix-ui/react-separator": "^1.1.11",
    "@radix-ui/react-tooltip": "^1.2.12",
    "@radix-ui/react-use-controllable-state": "^1.2.3",
    "@react-email/components": "^1.0.12",
    "@sentry/nextjs": "^10.60.0",
    "@shikijs/rehype": "^4.3.1",
    "@supabase/ssr": "^0.6.1",
    "@supabase/supabase-js": "^2.107.0",
    "@tanstack/react-table": "^8.21.3",
    "@upstash/redis": "^1.38.0",
    "chokidar": "^5.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "framer-motion": "^12.40.0",
    "gray-matter": "^4.0.3",
    "gsap": "^3.15.0",
    "lenis": "^1.3.23",
    "lucide-react": "^1.24.0",
    "motion": "^12.42.2",
    "next": "^15.1.0",
    "nuqs": "^2.9.0",
    "openai": "^4.77.0",
    "playwright-core": "^1.62.1",
    "radix-ui": "^1.6.2",
    "react": "^19.0.0",
    "react-aria-components": "^1.19.0",
    "react-dom": "^19.0.0",
    "react-hook-form": "^7.81.0",
    "react-markdown": "^10.1.0",
    "recharts": "^3.8.0",
    "remark-gfm": "^4.0.1",
    "resend": "^6.17.2",
    "server-only": "^0.0.1",
    "shiki": "^4.3.1",
    "sonner": "^2.0.7",
    "style-dictionary": "^5.5.0",
    "tailwind-merge": "^3.6.0",
    "tar": "^7.5.16",
    "usehooks-ts": "^3.1.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@svgr/webpack": "^8.1.0",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.1.0",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}

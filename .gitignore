# reference clone at the repo root, not part of the app.
# Leading slash is load-bearing: a bare `ui/` also matches src/components/ui/,
# which un-tracks every shadcn component and — because Tailwind v4 skips
# gitignored files during source detection — silently stops generating the
# utilities they use.
/ui/

# Runtime state written by the app and by test runs. These were tracked, so a
# deploy shipped a governance history of six "bypass" events authored by
# @verify — the test script, not a person — against a design system that only
# exists on a dev machine. The stores degrade to empty when the file is absent,
# which is the honest starting state for a fresh instance.
data/cloud/*.json
data/uploads/*.md
data/uploads/*.json
data/public-share/*.json

# Incremental TypeScript build artifact — regenerated by every typecheck.
tsconfig.tsbuildinfo

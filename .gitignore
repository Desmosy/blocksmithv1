# reference clone at the repo root, not part of the app.
# Leading slash is load-bearing: a bare `ui/` also matches src/components/ui/,
# which un-tracks every shadcn component and — because Tailwind v4 skips
# gitignored files during source detection — silently stops generating the
# utilities they use.
/ui/

# Runtime state written by the app and by test runs. The stores degrade to
# empty when the file is absent, which is the right start for a fresh instance.
data/cloud/*.json
data/uploads/*.md
data/uploads/*.json
data/public-share/*.json

# Incremental TypeScript build artifact.
tsconfig.tsbuildinfo

# Kept out of the repo; local copies remain on disk.
/JUDGING.md
/TESTING.md
/HACKATHON.md
/docs/MCP.md
/docs/BLOCKS-V1-SPEC.md
/docs/DESIGN-CICD.md
/Update.md


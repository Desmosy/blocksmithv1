# Supabase (https://supabase.com/dashboard → Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-publishable-or-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret

# BlockSmith cloud API (Patterns 2–4)
BLOCKSMITH_ADMIN_SECRET=generate-a-long-random-string

# Optional
BLOCKSMITH_WORKSPACE=/path/to/vendor-app
AI_LAB_SCAN_CURATE=0

# Design capture ingest (browser extension → /api/ingest/capture).
# Uses NVIDIA_API_KEY; optionally pin a specific NIM vision model:
# NVIDIA_MODEL_VISION=meta/llama-4-maverick-17b-128e-instruct

# Distributed rate limiting (Upstash Redis). Optional — falls back to in-memory if unset.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Error monitoring (Sentry). Unset = disabled.
NEXT_PUBLIC_SENTRY_DSN=

# Transactional org-invite email (Resend). Unset saves invitations without delivery.
RESEND_API_KEY=
BLOCKSMITH_EMAIL_FROM=BlockSmith <invites@your-domain.com>
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Figma fusion + webhook resync. Use an OAuth token in production where possible.
FIGMA_ACCESS_TOKEN=
FIGMA_WEBHOOK_PASSCODE=

# Capture rationale — judgement written over the measured design system
# (why a component matters, do/don't in the system's voice). Uses
# NVIDIA_API_KEY. Optional: pin a text model, or turn the pass off.
# NVIDIA_MODEL_RATIONALE=openai/gpt-oss-120b
# BLOCKSMITH_CAPTURE_RATIONALE=0

{
  "name": "@blocksmith/sdk",
  "version": "0.1.0",
  "description": "BlockSmith HTTP API client — scans, auth, pull, remote cloud",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./design-md": {
      "types": "./dist/design-md.d.ts",
      "import": "./dist/design-md.js"
    }
  },
  "files": ["dist", "README.md"],
  "scripts": {
    "build": "tsc",
    "prepublishOnly": "npm run build"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/blocksmith/blocksmith.git",
    "directory": "packages/sdk"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": ["blocksmith", "design-system", "mcp"],
  "license": "AGPL-3.0-only",
  "engines": {
    "node": ">=18"
  }
}
